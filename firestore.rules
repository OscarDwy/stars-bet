rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tout utilisateur authentifié peut lire
    // Les écritures sur les paris et users sont contrôlées côté client (transactions)
    // Pour un usage entre amis ces règles sont suffisantes ; pour un vrai prod il faudrait un backend.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;
    }
    match /bets/{betId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
